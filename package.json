{
  "name": "frametv-shadowbox",
  "version": "0.1.0",
  "description": "Faux 3D shadowbox ambient display with animated water for Samsung Frame TVs",
  "packageType": "app",
  "appName": "Shadowbox",
  "appPath": "app/index.html",
